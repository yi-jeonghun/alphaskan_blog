---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
<style>
	/* ==============================
	   Post Header
	   ============================== */

	.title {
		max-width: 760px;
		margin: 0 auto;
		padding: 4rem 1.5rem 2.5rem;
		text-align: left;
	}

	.title h1 {
		margin: 0.6rem 0 0;
		font-size: 2.5rem;
		line-height: 1.25;
		letter-spacing: -0.04em;
		font-weight: 700;
	}

	.title .date {
		color: #667085;
		font-size: 0.95rem;
	}

	/* ==============================
	   Article Body
	   ============================== */

	.prose {
		max-width: 760px;
		margin: 0 auto;
		padding: 1rem 1.5rem 6rem;
		font-size: 1.05rem;
		line-height: 1.85;
		color: #1f2937;
	}

	/* Paragraph */

	.prose :global(p) {
		margin: 0 0 1.6rem;
	}

	/* ==============================
	   Headings
	   ============================== */

	.prose :global(h2) {
		margin: 4.5rem 0 1.25rem;
		font-size: 1.35rem;
		line-height: 1.45;
		letter-spacing: -0.02em;
		font-weight: 700;
		color: #111827;
	}

	.prose :global(h3) {
		margin: 3rem 0 1rem;
		font-size: 1.15rem;
		line-height: 1.45;
		letter-spacing: -0.015em;
		font-weight: 700;
		color: #111827;
	}

	/* ==============================
	   Links
	   ============================== */

	.prose :global(a) {
		color: #2563eb;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	/* ==============================
	   Images
	   ============================== */

	.prose :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 2.5rem 0;
		border-radius: 8px;
	}

	/* ==============================
	   Lists
	   ============================== */

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.75rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin: 0.45rem 0;
		padding-left: 0.2rem;
	}

	/* ==============================
	   Blockquote
	   ============================== */

	.prose :global(blockquote) {
		margin: 2rem 0;
		padding: 0.25rem 0 0.25rem 1.25rem;
		border-left: 4px solid #d0d5dd;
		color: #475467;
	}

	.prose :global(blockquote p) {
		margin: 0;
	}

	/* ==============================
	   Inline Code
	   ============================== */

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border-radius: 4px;
		background: #f2f4f7;
		font-size: 0.9em;
	}

	/* Code Block */

	.prose :global(pre) {
		overflow-x: auto;
		margin: 2rem 0;
		padding: 1.25rem;
		border-radius: 8px;
		background: #111827;
		line-height: 1.6;
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	/* ==============================
	   Divider
	   ============================== */

	.prose :global(hr) {
		margin: 3.5rem 0;
		border: 0;
		border-top: 1px solid #e5e7eb;
	}

	/* ==============================
	   Bold
	   ============================== */

	.prose :global(strong) {
		font-weight: 700;
		color: #111827;
	}

	/* ==============================
	   Mobile
	   ============================== */

	@media (max-width: 640px) {
		.title {
			padding: 2.75rem 1.25rem 2rem;
		}

		.title h1 {
			font-size: 2rem;
			line-height: 1.3;
		}

		.prose {
			padding: 0.75rem 1.25rem 4rem;
			font-size: 1rem;
			line-height: 1.8;
		}

		.prose :global(h2) {
			margin-top: 4rem;
			margin-bottom: 1rem;
			font-size: 1.3rem;
			line-height: 1.4;
		}

		.prose :global(h3) {
			margin-top: 2.75rem;
			font-size: 1.1rem;
		}

		.prose :global(img) {
			margin: 2rem 0;
			border-radius: 6px;
		}
	}
</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
